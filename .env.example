# -----------------------------------------------------------------------------
# Template for .env — copy to .env and fill in. Committed on purpose; keep it
# free of real values.
#
# Expo only exposes vars prefixed EXPO_PUBLIC_ to app code, and it INLINES them
# in plain text into the compiled bundle. Treat everything here as public.
# Server-side secrets (Anthropic key, Supabase secret key) go to edge-function
# secrets instead — see README "Environment".
# -----------------------------------------------------------------------------

# Supabase Dashboard -> Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase Dashboard -> Settings -> API Keys -> Publishable key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only if you add native Google sign-in (@react-native-google-signin).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# -----------------------------------------------------------------------------
# Keys that must NEVER live in this file, and where they go instead:
#
#   ANTHROPIC_API_KEY   -> supabase/functions/.env  (local dev)
#                       -> `supabase secrets set`   (production)
#   Supabase secret key -> nowhere; edge functions get SUPABASE_SECRET_KEYS free
#   Google OAuth secret -> Supabase Dashboard -> Authentication -> Providers
#   Apple sign-in creds -> Supabase Dashboard -> Authentication -> Providers
# -----------------------------------------------------------------------------
