# -----------------------------------------------------------------------------
# Template for .env — copy to .env and fill in. Committed on purpose; keep it
# free of real values.
#
# Expo only exposes vars prefixed EXPO_PUBLIC_ to app code, and it INLINES them
# in plain text into the compiled bundle. Treat everything here as public.
# Server-side secrets go to workers/.dev.vars (local) and `wrangler secret put`
# (production) instead — see workers/README.md "Secrets".
#
# LEGACY as of 2026-08-02: the backend is Cloudflare (workers/), not Supabase.
# The two Supabase vars below survive only because src/lib/supabase.ts still
# throws at import without them; nothing else reads them. They go when the client
# is moved onto workers/.
# -----------------------------------------------------------------------------

# Supabase Dashboard -> Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase Dashboard -> Settings -> API Keys -> Publishable key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The workers/ backend's origin. The Worker IS deployed (confirmed live 2026-08-09) at
# https://pace-blueprint-production.i78979848.workers.dev — that is the default below and the
# right value for every device type unless you are also running `wrangler dev` locally.
#
# `localhost` MEANS "THIS DEVICE", AND THAT IS WHERE MOST TESTING GOES WRONG. It resolves to your
# computer only when the app runs on your computer — `npm run web`, or the iOS simulator. On a real
# phone via Expo Go it resolves to the phone, where nothing is listening, and every request fails
# with `TypeError: Network request failed`. Tunnel mode does not help: `expo start --tunnel`
# forwards the Metro bundler, never the Worker — it does nothing for this variable. Per device
# type:
#
#   web / iOS simulator / phone   https://pace-blueprint-production.i78979848.workers.dev (default)
#   local backend dev             http://localhost:8787 — only if `wrangler dev` is actually
#                                 running (workers/README.md); keep the port matching
#                                 wrangler.toml's BETTER_AUTH_URL, a mismatch fails exactly like an
#                                 unreachable host.
#
# Expo inlines this value at BUILD time, so changing it needs a dev-server restart, not a reload.
EXPO_PUBLIC_API_BASE_URL=https://pace-blueprint-production.i78979848.workers.dev

# Only if you add native Google sign-in (@react-native-google-signin).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# -----------------------------------------------------------------------------
# Keys that must NEVER live in this file, and where they go instead:
#
#   ANTHROPIC_API_KEY   -> workers/.dev.vars      (local dev)
#                       -> `wrangler secret put`  (production)
#   BETTER_AUTH_SECRET  -> same two places
#   Google OAuth secret -> same two places (never a committed file, and never
#                          workers/wrangler.toml, which IS committed)
#   Apple sign-in creds -> parked entirely, see docs/apple-dev-blocked.md
# -----------------------------------------------------------------------------
