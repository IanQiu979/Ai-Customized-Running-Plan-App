# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (.env.example is committed as the template)
.env
.env*.local
supabase/functions/.env
# Cloudflare Workers local secrets — wrangler dev's equivalent of supabase/functions/.env.
# workers/.dev.vars.example is committed as the template.
workers/.dev.vars

# Cloudflare Workers — local Miniflare state (the local D1 file lives here) and build output
workers/.wrangler/
workers/node_modules/

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# session handoff notes
.claude/HANDOFF.md

# Claude Code agent worktrees — local only, never committed
.claude/worktrees/
