# -----------------------------------------------------------------------------
# Template for supabase/functions/.env — copy it, then fill in the real values.
# Committed on purpose; keep it free of real keys.
#
#   cp supabase/functions/.env.example supabase/functions/.env
#
# These are server-side secrets for Supabase Edge Functions. They are never
# bundled into the app. See README "Environment".
# -----------------------------------------------------------------------------

# console.anthropic.com -> Settings -> API keys
ANTHROPIC_API_KEY=

# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS and SUPABASE_SECRET_KEYS are injected
# into edge functions automatically. Do not add them here.
